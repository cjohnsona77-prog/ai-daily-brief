# Required
TAVILY_API_KEY=tvly-xxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Optional: Resend Audience ID for subscriber list management.
# If not set, emails go to FALLBACK_RECIPIENTS only.
RESEND_AUDIENCE_ID=

# Optional: sender and recipient configuration
FROM_EMAIL=AI Brief <brief@yourdomain.com>
ALERT_EMAIL=you@example.com
FALLBACK_RECIPIENTS=you@example.com
